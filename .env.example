# AI endpoints are OpenAI-compatible (base URL ending in /v1). Every one is optional.
# Primary text model: interview questions, transcript to story
OPENAI_KEY=
OPENAI_URL=
OPENAI_MODEL=
# Fallback text model
OPENAI_BACKUP_KEY=
OPENAI_BACKUP_URL=
OPENAI_BACKUP_MODEL=
# Speech-to-text; the same endpoint serves embeddings and the seed voices
OPENAI_LISTEN_KEY=
OPENAI_LISTEN_URL=
OPENAI_LISTEN_MODEL=
OPENAI_EMBED_MODEL=
OPENAI_VOICE_MODEL=
DATABASE_PATH=./data/hereabouts.db
AUDIO_DIR=./data/audio
SESSION_SECRET=change-me

# Email sign-in codes. Without a key, codes are printed to the server log instead.
RESEND_API_KEY=
# Set to 1 to also print sign-in codes to the server log (always on when no key is set).
AUTH_LOG_CODES=
EMAIL_FROM="Hereabouts <noreply@example.com>"
# Google sign-in (optional). Register APP_URL + /auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:8080
PHOTO_DIR=./data/photos
